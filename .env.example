# Personal Agents Environment Variables
# Copy this file to .env and fill in your actual values

# Google API Key for Gemini model
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Server configuration
AGNO_URL=http://localhost:7777

# Database configuration
# Option 1: MongoDB (recommended for production)
DB_URL=mongodb://mongoadmin:secret@localhost:27017

# Option 2: SQLite (fallback, relative to project root)
DB_FILE=research_team.db

# Optional: Additional configuration
# LOG_LEVEL=INFO
# MAX_REQUESTS_PER_MINUTE=60